# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/release

# cloud sync data (server-side snapshot)
/data/
/data/measure-images/

# local exports / one-off workbooks
/exports/

# Cursor IDE local artifacts (not part of the app runtime)
/.cursor/

# Understand Anything / agent knowledge-graph cache (local only)
/.ua/

# misc
.DS_Store
*.pem

# local tooling binaries & one-off import artifacts
/tools/*.exe
/pdf-extract.txt
/import-summary.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
