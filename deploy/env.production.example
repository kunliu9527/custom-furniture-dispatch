# 国内云生产环境 — 复制为项目根目录 .env.local
# 文档：docs/CHINA-SERVER-DEPLOY.md

NEXT_PUBLIC_REMOTE_SYNC=true
SYNC_API_KEY=请改成复杂密码
NEXT_PUBLIC_SYNC_API_KEY=请改成与上面相同

# 国内单机推荐：磁盘持久化（无需 Redis）
SYNC_STORAGE=file
SYNC_DATA_DIR=/var/lib/custom-furniture-dispatch

PORT=3000
NODE_ENV=production

# 可选
# NEXT_PUBLIC_SYNC_POLL_MS=8000

# 周报企微（可选，服务器 cron 用）
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# DIGEST_PUSH_KEY=与 SYNC_API_KEY 可相同

# HTTPS 注意：
# - 浏览器请用 https://你的域名 或全程 http://公网IP，不要混用
# - 切勿配置 NEXT_PUBLIC_* 为 http://IP（HTTPS 页面会混合内容失败）
# - 所有 /api 请求已走同源相对路径，无需 NEXT_PUBLIC_API_URL
