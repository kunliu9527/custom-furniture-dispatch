# 国内云生产环境 — 复制为项目根目录 .env.local
# 文档：docs/CHINA-SERVER-DEPLOY.md

NEXT_PUBLIC_REMOTE_SYNC=true
SYNC_API_KEY=请改成复杂密码
NEXT_PUBLIC_SYNC_API_KEY=请改成与上面相同

# 国内单机推荐：磁盘持久化（无需 Redis）
SYNC_STORAGE=file
SYNC_DATA_DIR=/var/lib/custom-furniture-dispatch

PORT=3000
NODE_ENV=production

# 可选
# NEXT_PUBLIC_SYNC_POLL_MS=8000
